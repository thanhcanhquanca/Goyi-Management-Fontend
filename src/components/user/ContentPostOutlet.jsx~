import React, { useState } from 'react';
import { Card, CardHeader, CardMedia, CardContent, CardActions, Avatar, IconButton, Typography, Link, Grid, Menu, MenuItem, Divider, Modal, Box } from '@mui/material';
import { Favorite as FavoriteIcon, Comment as CommentIcon, Share as ShareIcon, Visibility as VisibilityIcon, MoreVert } from '@mui/icons-material';
import MoreHorizIcon from '@mui/icons-material/MoreHoriz';

function ContentPostOutlet() {
    const images = [
        'https://i.pinimg.com/originals/a6/00/ed/a600ed85ebfdb2893dd147e855b45988.jpg',
        'https://thuthuatnhanh.com/wp-content/uploads/2023/10/hinh-anh-3d-dep-cute-lam-hinh-nen-dien-thoai-1.jpg',
        'https://cdn.donmai.us/original/75/90/7590d00ce911c039c1a7bc294bc52e07.jpg',
        'https://img5.thuthuatphanmem.vn/uploads/2021/07/15/anh-3d-dep-buon_043316269.jpg',
        'https://anhcuoiviet.vn/wp-content/uploads/2022/09/de-thuong-2-724x965.jpg',
        'https://thuthuatnhanh.com/wp-content/uploads/2023/10/hinh-anh-3d-dep-cute-lam-hinh-nen-dien-thoai-1.jpg',
        'https://cdn.donmai.us/original/75/90/7590d00ce911c039c1a7bc294bc52e07.jpg',
        'https://i.pinimg.com/originals/07/f9/df/07f9df953582c38d9d38de1f044e7b06.png',
        'https://cdn.donmai.us/original/8b/a7/8ba7de69b78681dc757f4fd3eca581b7.jpg',
    ];

    const [anchorEl, setAnchorEl] = useState(null);
    const open = Boolean(anchorEl);

    const handleMenuClick = (event) => {
        setAnchorEl(event.currentTarget);
    };

    const handleMenuClose = () => {
        setAnchorEl(null);
    };

    const [openModal, setOpenModal] = useState(false);
    const [selectedImage, setSelectedImage] = useState(null);
    const [zoomLevel, setZoomLevel] = useState(1);
    const [zoomFocus, setZoomFocus] = useState({ x: '50%', y: '50%' }); // Default center focus

    const handleOpenModal = (image) => {
        setSelectedImage(image);
        setZoomLevel(1);
        setZoomFocus({ x: '50%', y: '50%' });
        setOpenModal(true);
    };

    const handleCloseModal = () => {
        setOpenModal(false);
        setSelectedImage(null);
        setZoomLevel(1);
        setZoomFocus({ x: '50%', y: '50%' });
    };

    const handleWheel = (event) => {
        event.preventDefault();
        const zoomSpeed = 0.1;
        const delta = event.deltaY > 0 ? -zoomSpeed : zoomSpeed;
        setZoomLevel((prevZoom) => Math.min(Math.max(prevZoom + delta, 1), 3));
    };

    const handleImageClick = (event) => {
        const rect = event.currentTarget.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width) * 100;
        const y = ((event.clientY - rect.top) / rect.height) * 100;
        setZoomFocus({ x: `${x}%`, y: `${y}%` });
    };

    const [showFullContent, setShowFullContent] = useState(false);
    const content = "Xem thêm ảnh tại na tul lư Xem thêm ảnh tại na tul l Xem thêm ảnh tại na tul lư Xem thêm ảnh tại na tul l Xem thêm ảnh tại na tul lư Xem thêm ảnh tại na tul l Xem thêm ảnh tại na tul lư Xem thêm ảnh tại na tul l Xem thêm ảnh tại na tul lư Xem thêm ảnh tại na tul l Xem thêm ảnh tại na tul lư Xem thêm ảnh tại na tul l Xem thêm ảnh tại na tul lư Xem thêm ảnh tại na tul l Xem thêm ảnh tại na tul lư Xem thêm ảnh tại na tul l";
    const shortContent = content.substring(0, 200) + "...";

    return (
        <Card sx={{ maxWidth: 800, margin: '20px auto', boxShadow: 3, position: 'relative' }}>
            <CardHeader
                avatar={<Avatar alt="Thanh Anhh" src="path-to-avatar.jpg" />}
                title={
                    <Typography variant="subtitle1" fontWeight="bold">
                        Thanh Anhh
                    </Typography>
                }
                subheader="Cập nhật ảnh đại diện - 29 tháng 5 lúc 17:54"
                action={
                    <IconButton
                        aria-label="settings"
                        aria-controls="menu-appbar"
                        aria-haspopup="true"
                        onClick={handleMenuClick}
                        color="inherit"
                    >
                        <MoreHorizIcon />
                    </IconButton>
                }
            />
            <Menu
                id="menu-appbar"
                anchorEl={anchorEl}
                open={open}
                onClose={handleMenuClose}
                anchorOrigin={{
                    vertical: 'top',
                    horizontal: 'right',
                }}
                transformOrigin={{
                    vertical: 'top',
                    horizontal: 'right',
                }}
            >
                <MenuItem onClick={handleMenuClose}>Chỉnh sửa</MenuItem>
                <MenuItem onClick={handleMenuClose}>Xóa</MenuItem>
                <MenuItem onClick={handleMenuClose}>Báo cáo</MenuItem>
            </Menu>
            <CardContent>
                <Typography variant="body2" color="text.secondary">
                    {showFullContent ? content : shortContent}
                    {!showFullContent && (
                        <Link
                            component="button"
                            variant="body2"
                            onClick={() => setShowFullContent(true)}
                            sx={{ color: 'blue', cursor: 'pointer', ml: 1 }}
                        >
                            Xem thêm
                        </Link>
                    )}
                    {showFullContent && (
                        <Link
                            component="button"
                            variant="body2"
                            onClick={() => setShowFullContent(false)}
                            sx={{ color: 'blue', cursor: 'pointer', ml: 1 }}
                        >
                            Ẩn đi
                        </Link>
                    )}
                </Typography>
            </CardContent>
            <Grid container spacing={2} justifyContent="center">
                {images.map((image, index) => (
                    <Grid item xs={12} sm={6} md={4} key={index}>
                        <CardMedia
                            component="img"
                            height="200"
                            image={image}
                            alt={`Post image ${index + 1}`}
                            onClick={() => handleOpenModal(image)}
                            sx={{ cursor: 'pointer' , width:'250px', height:'250px'}}
                        />
                    </Grid>
                ))}
            </Grid>
            <Divider sx={{ my: 1, borderColor: 'rgba(0, 0, 0, 0.1)', mt: '30px' }} />
            <CardActions disableSpacing>
                <IconButton aria-label="like">
                    <FavoriteIcon />
                    <Typography variant="body2" sx={{ ml: 1 }}>6</Typography>
                </IconButton>
                <IconButton aria-label="comment">
                    <CommentIcon />
                    <Typography variant="body2" sx={{ ml: 1 }}>15</Typography>
                </IconButton>
                <IconButton aria-label="share">
                    <ShareIcon />
                    <Typography variant="body2" sx={{ ml: 1 }}>3</Typography>
                </IconButton>
                <IconButton aria-label="views">
                    <VisibilityIcon />
                    <Typography variant="body2" sx={{ ml: 1 }}>20</Typography>
                </IconButton>
            </CardActions>

            <Modal
                open={openModal}
                onClose={handleCloseModal}
                aria-labelledby="modal-modal-title"
                aria-describedby="modal-modal-description"
            >
                <Box
                    sx={{
                        position: 'absolute',
                        top: '50%',
                        left: '50%',
                        transform: `translate(-50%, -50%) scale(${zoomLevel})`, // Áp dụng chế độ thu phóng cho toàn bộ Hộp
                        transformOrigin: `${zoomFocus.x} ${zoomFocus.y}`, // Phóng to từ điểm được nhấp
                        transition: 'transform 0.2s ease', // Chuyển đổi thu phóng mượt mà
                        width: '80%',
                        maxWidth: 800,
                        bgcolor: 'background.paper',
                        boxShadow: 24,
                        p: 4,
                        overflow: 'hidden',
                    }}
                >
                    <img
                        src={selectedImage}
                        alt="Enlarged view"
                        onWheel={handleWheel}
                        onClick={handleImageClick}
                        style={{
                            width: '100%',
                            height: 'auto',
                        }}
                    />
                </Box>
            </Modal>
        </Card>
    );
}

export default ContentPostOutlet;